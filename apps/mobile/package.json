    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@aytracker/tracking-client": "workspace:*",
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "typescript": "^5.7.3"
  }
}
