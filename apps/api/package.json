{
  "name": "@aytracker/api",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@aytracker/auth": "workspace:*",
    "@aytracker/billing": "workspace:*",
    "@aytracker/config": "workspace:*",
    "@aytracker/database": "workspace:*",
    "@aytracker/domain": "workspace:*",
    "@aytracker/localization": "workspace:*",
    "@aytracker/market": "workspace:*",
    "@aytracker/module-audit": "workspace:*",
    "@aytracker/module-drivers": "workspace:*",
    "@aytracker/module-fleet": "workspace:*",
    "@aytracker/module-production": "workspace:*",
    "@aytracker/module-recommendations": "workspace:*",
    "@aytracker/module-reporting": "workspace:*",
    "@aytracker/module-shifts": "workspace:*",
    "@aytracker/module-workforce": "workspace:*",
    "@aytracker/tracking": "workspace:*",
    "@aytracker/types": "workspace:*",
    "@aytracker/validation": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./services/container": {
      "types": "./dist/services/container.d.ts",
      "default": "./dist/services/container.js"
    }
  }
}
