# ---------------------------------------------------------------------------
# AYtracker v2 — environment template
# Copy to .env.local (development) / .env.test (tests). NEVER commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Core services --------------------------------------------------------
DATABASE_URL=postgresql://aytracker:aytracker@localhost:5432/aytracker?schema=public
# Optional. Required for distributed rate limiting and session revocation at scale.
REDIS_URL=

# --- URLs -----------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001
# Comma-separated list of browser origins allowed to send credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Sessions & crypto ----------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=
# Cookie domain for session cookies. Leave empty for host-only cookies.
SESSION_COOKIE_DOMAIN=
SESSION_TTL_ADMIN_MINUTES=720
SESSION_TTL_WORKER_MINUTES=960
SESSION_TTL_DRIVER_MINUTES=960

# --- Market resolution ----------------------------------------------------
DEFAULT_MARKET=GLOBAL
DEFAULT_LOCALE=en
# Server-side IP geolocation provider key. Display/pricing signal only.
MARKET_GEOLOCATION_KEY=
MARKET_GEOLOCATION_PROVIDER=none

# --- Billing (Stripe) -----------------------------------------------------
BILLING_PROVIDER=noop
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# EU VAT number validation (VIES). Set to 'none' to disable.
VAT_VALIDATION_PROVIDER=none

# --- Object storage (branding assets, documents) --------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# --- Tracking / routing ---------------------------------------------------
ROUTING_PROVIDER=haversine
ROUTING_PROVIDER_API_KEY=
# Raw GPS point retention, in days. Trip summaries are retained separately.
LOCATION_RETENTION_DAYS=180
TRIP_SUMMARY_RETENTION_DAYS=1825
AUDIT_RETENTION_DAYS=2555

# --- Observability --------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- Public web app (must be safe to expose to the browser) ---------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=AYtracker
